DATABASE_URL=sqlite:///./data/app.db

STORAGE_DIR=./storage/documents

MAX_UPLOAD_SIZE_MB=30

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Primary API key
LLM_API_KEY=

# Optional fallback API key
LLM_FALLBACK_API_KEY=

# Deferred Retry
# Số lần retry bổ sung sau Primary Pass
LLM_MAX_RETRIES=1

# Exponential backoff
LLM_BASE_DELAY=2
LLM_MAX_DELAY=20