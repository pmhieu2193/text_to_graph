DATABASE_URL=sqlite:///./data/app.db

STORAGE_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=30

# LLM
# Optional environment fallback for local/Docker/headless runs.
# Values saved from the Settings page in data/settings.json override these at startup.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_FALLBACK_API_KEY=
LLM_MAX_RETRIES=1
LLM_BASE_DELAY=2
LLM_MAX_DELAY=20

# Entity Resolution
ER_INDEX_DIR=./data/entity_resolution/indexes
ER_REPORT_DIR=./data/entity_resolution/reports
ER_EMBEDDING_MODEL=BAAI/bge-m3
ER_EMBEDDING_BATCH_SIZE=16
ER_EMBEDDING_MAX_LENGTH=128
ER_FAISS_TOP_K=50
ER_EMBEDDING_CANDIDATE_LIMIT=10
ER_STRING_TOP_K=10
ER_FUZZY_AUTO_THRESHOLD=0.92
ER_EMBEDDING_AUTO_THRESHOLD=0.90
ER_FUZZY_REVIEW_THRESHOLD=0.80
ER_EMBEDDING_REVIEW_THRESHOLD=0.80
ER_AUTO_MERGE_EXACT=false
ER_REPORT_FORMAT=xlsx

# Neo4j (required for Docker Compose and graph synchronization).
# Change this sample password before the first Docker Compose startup.
# These environment variables remain supported as deployment fallbacks; Settings can override them.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_this_neo4j_password
NEO4J_DATABASE=neo4j

# Docker Compose
APP_PORT=8080
BACKEND_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
