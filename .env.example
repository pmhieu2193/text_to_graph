DATABASE_URL=sqlite:///./data/app.db

STORAGE_DIR=./storage/documents

MAX_UPLOAD_SIZE_MB=30

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Primary API key
LLM_API_KEY= 

# Optional fallback API key
LLM_FALLBACK_API_KEY=

# Deferred Retry
LLM_MAX_RETRIES=1

# Exponential backoff
LLM_BASE_DELAY=2
LLM_MAX_DELAY=20

# Entity Resolution
ER_INDEX_DIR=./storage/entity_resolution/indexes
ER_REPORT_DIR=./storage/entity_resolution/reports

# Embedding model for entity resolution
ER_EMBEDDING_MODEL=BAAI/bge-m3
ER_EMBEDDING_BATCH_SIZE=16
ER_EMBEDDING_MAX_LENGTH=128

# Entity resolution parameters
ER_FAISS_TOP_K=50
ER_EMBEDDING_CANDIDATE_LIMIT=10
ER_STRING_TOP_K=10

# Auto thresholds for entity resolution
ER_FUZZY_AUTO_THRESHOLD=0.92
ER_EMBEDDING_AUTO_THRESHOLD=0.90
ER_FUZZY_REVIEW_THRESHOLD=0.80
ER_EMBEDDING_REVIEW_THRESHOLD=0.80

# Auto merge
ER_AUTO_MERGE_EXACT=false

# Report format for entity resolution
ER_REPORT_FORMAT=xlsx
